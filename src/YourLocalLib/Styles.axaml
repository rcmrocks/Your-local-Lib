<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="TextBlock.hero">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
    <Setter Property="FontSize" Value="46" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="52" />
  </Style>
  <Style Selector=":is(TextBlock).author">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector=":is(TextBlock).muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
    <Setter Property="FontSize" Value="28" />
  </Style>
  <Style Selector="TextBlock.wordmark">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="28" />
  </Style>
  <Style Selector="Border.cover">
    <Setter Property="Width" Value="168" />
    <Setter Property="Height" Value="252" />
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 8 18 0 #22000000" />
  </Style>
  <Style Selector="Border.rail">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="16,28,16,16" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.mode.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.mode.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.nav.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Button.quiet:pointerover">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Button.support">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="8,10" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Fluent colors the template's presenter on hover and press, so these target it directly. -->
  <Style Selector="Button.support:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SupportTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SupportBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Button.support:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SupportTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SupportBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Button.support PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource SupportBrush}" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector=":is(TextBlock).problem">
    <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
  </Style>
  <Style Selector="Ellipse.ok">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Ellipse.problem">
    <Setter Property="Fill" Value="{DynamicResource ProblemBrush}" />
  </Style>
</Styles>
